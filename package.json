{
    "name": "trezedo-blog",
    "version": "3.0.0",
    "description": "Blog project of vuepress-theme-hope",
    "license": "MIT",
    "author": "Trezedo",
    "scripts": {
        "build:all": "pnpm build:lib && pnpm docs:build",
        "build:lib": "pnpm --filter \"vuepress-plugin-deco\" run build",
        "docs:build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vuepress-vite build docs",
        "docs:clean-dev": "vuepress-vite dev docs --clean-cache",
        "docs:dev": "vuepress-vite dev docs",
        "docs:up": "pnpm dlx vp-update",
        "preview": "pnpm exec vite preview --host",
        "push:ge": "git push gitee main",
        "push:gh": "git push github main",
        "docs:fmt": "prettier --write 'docs/**/*.{ts,md}'",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "hook": "lefthook install",
        "cjk:lint": "autocorrect --lint ./docs/",
        "cjk:fix": "autocorrect --fix ./docs/"
    },
    "dependencies": {
        "notivue": "^2.4.5"
    },
    "devDependencies": {
        "@types/three": "^0.184.0",
        "@viz-js/viz": "^3.26.0",
        "@vue/repl": "^4.7.2",
        "@vuepress/bundler-vite": "2.0.0-rc.28",
        "@vuepress/plugin-comment": "2.0.0-rc.128",
        "@vuepress/plugin-markdown-math": "2.0.0-rc.128",
        "@vuepress/plugin-notice": "2.0.0-rc.128",
        "@vuepress/plugin-register-components": "2.0.0-rc.128",
        "@vuepress/plugin-revealjs": "2.0.0-rc.128",
        "@vuepress/plugin-slimsearch": "2.0.0-rc.129",
        "@vueuse/core": "^14.2.1",
        "autocorrect-node": "^2.14.0",
        "cross-env": "^7.0.3",
        "flowchart.ts": "^3.0.1",
        "lefthook": "^2.1.6",
        "markmap-lib": "^0.18.12",
        "markmap-toolbar": "^0.18.12",
        "markmap-view": "^0.18.12",
        "mermaid": "^11.14.0",
        "oxfmt": "^0.42.0",
        "oxlint": "^1.62.0",
        "oxlint-tsgolint": "^0.20.0",
        "prettier": "^3.8.3",
        "rumdl": "^0.1.85",
        "sass-embedded": "^1.99.0",
        "three": "^0.184.0",
        "vue": "^3.5.33",
        "vuepress": "2.0.0-rc.28",
        "vuepress-plugin-components": "2.0.0-rc.106",
        "vuepress-plugin-md-enhance": "2.0.0-rc.106",
        "vuepress-theme-hope": "2.0.0-rc.106"
    },
    "engines": {
        "pnpm": ">=10.0.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "esbuild",
            "lefthook"
        ]
    }
}
