{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "es2022",
        "baseUrl": "./",
        "paths": {
            "@zedo": ["custom"], // 注意末尾不能有斜杠
            "@zedo/*": ["custom/*"]
        },
        "sourceMap": true,
        "downlevelIteration": true,
        "types": ["vuepress/client-types"],
        "skipLibCheck": true,
        "jsx": "preserve",
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "include": ["./custom/**/*", "docs/.vuepress/**/*.ts", "docs/.vuepress/**/*.vue"],
    "exclude": ["node_modules"]
}
