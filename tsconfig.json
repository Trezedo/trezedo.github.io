{
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "@zedo": ["custom/"],
            "@zedo/*": ["custom/*"]
        },
        "module": "commonjs",
        "target": "es5",
        "sourceMap": true,
        "downlevelIteration": true,
        "types": ["@vuepress/client/types"],
        "skipLibCheck": true,
        "jsx": "preserve"
    },
    "include": ["custom/**/*.ts", "custom/**/*.vue"],
    "exclude": ["node_modules"]
}
