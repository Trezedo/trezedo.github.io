{
  "name": "trezedo-blog",
  "version": "3.0.0",
  "description": "Blog project of vuepress-theme-hope",
  "author": "Trezedo",
  "license": "MIT",
  "scripts": {
    "build:all": "pnpm build:lib && pnpm docs:build",
    "build:lib": "pnpm --filter \"vuepress-plugin-deco\" run build",
    "docs:build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vuepress build docs",
    "docs:clean-dev": "vuepress dev docs --clean-cache",
    "docs:dev": "vuepress dev docs",
    "docs:up": "pnpm dlx vp-update",
    "preview": "vite preview --host",
    "push:ge": "git push gitee main",
    "push:gh": "git push github main"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@vuepress/bundler-vite": "2.0.0-rc.24",
    "@vuepress/plugin-comment": "2.0.0-rc.112",
    "@vuepress/plugin-markdown-chart": "2.0.0-rc.112",
    "@vuepress/plugin-markdown-math": "2.0.0-rc.112",
    "@vuepress/plugin-notice": "2.0.0-rc.112",
    "@vuepress/plugin-register-components": "2.0.0-rc.112",
    "@vuepress/plugin-revealjs": "2.0.0-rc.112",
    "@vuepress/plugin-search": "2.0.0-rc.112",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.112",
    "cross-env": "^7.0.3",
    "flowchart.ts": "^3.0.1",
    "katex": "^0.16.23",
    "mermaid": "^11.12.0",
    "sass-embedded": "^1.93.2",
    "vite": "^4.5.14",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vuepress": "2.0.0-rc.24",
    "vuepress-plugin-components": "2.0.0-rc.94",
    "vuepress-plugin-md-enhance": "2.0.0-rc.94",
    "vuepress-theme-hope": "2.0.0-rc.94"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "sass-loader",
        "@types/node",
        "ts-node",
        "react",
        "react-dom"
      ]
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
