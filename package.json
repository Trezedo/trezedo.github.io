{
    "name": "trezedo-blog",
    "version": "2.3.0",
    "description": "Blog project of vuepress-theme-hope",
    "author": "Trezedo",
    "license": "MIT",
    "scripts": {
        "build:all": "pnpm build:lib && pnpm docs:build",
        "build:lib": "pnpm --filter \"vuepress-plugin-deco\" run build",
        "docs:build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vuepress build docs",
        "docs:clean-dev": "vuepress dev docs --clean-cache",
        "docs:dev": "vuepress dev docs",
        "docs:up": "pnpm dlx vp-update",
        "preview": "vite preview --host",
        "push:ge": "git push gitee main",
        "push:gh": "git push github main"
    },
    "devDependencies": {
        "@vuepress/client": "2.0.0-beta.66",
        "@vuepress/plugin-register-components": "2.0.0-beta.66",
        "@vuepress/plugin-search": "2.0.0-beta.66",
        "@vuepress/shared": "2.0.0-beta.66",
        "@vuepress/utils": "2.0.0-beta.66",
        "cross-env": "^7.0.3",
        "vite": "^4.4.5",
        "vue": "^3.3.4",
        "vue-router": "^4.2.4",
        "vuepress": "2.0.0-beta.66",
        "vuepress-plugin-comment2": "2.0.0-beta.233",
        "vuepress-plugin-components": "2.0.0-beta.233",
        "vuepress-plugin-search-pro": "2.0.0-beta.233",
        "vuepress-theme-hope": "2.0.0-beta.233"
    },
    "pnpm": {
        "peerDependencyRules": {
            "ignoreMissing": [
                "sass-loader",
                "@types/node",
                "ts-node",
                "react",
                "react-dom"
            ]
        }
    },
    "packageManager": "pnpm@8.6.9"
}
