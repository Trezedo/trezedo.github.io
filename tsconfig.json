{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "@zedo": ["custom"], // 注意末尾不能有斜杠
            "@zedo/*": ["custom/*"]
        },
        "module": "commonjs",
        "target": "es5",
        "sourceMap": true,
        "downlevelIteration": true,
        "types": ["@vuepress/client/types"],
        "skipLibCheck": true,
        "jsx": "preserve",
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "include": ["./custom/**/*", "**/.vuepress/**/*"],
    "exclude": ["node_modules"]
}
