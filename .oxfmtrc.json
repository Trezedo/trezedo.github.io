{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "ignorePatterns": ["/**/.obsidian", "public/**"],
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 100,
    "endOfLine": "lf",
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "sortPackageJson": true,
    "embeddedLanguageFormatting": "auto" // 格式化 markdown 内部的代码块
}
