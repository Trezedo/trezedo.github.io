{
  "name": "trezedo-blog",
  "version": "3.0.0",
  "description": "Blog project of vuepress-theme-hope",
  "author": "Trezedo",
  "license": "MIT",
  "scripts": {
    "build:all": "pnpm build:lib && pnpm docs:build",
    "build:lib": "pnpm --filter \"vuepress-plugin-deco\" run build",
    "docs:build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vuepress-vite build docs",
    "docs:clean-dev": "vuepress-vite dev docs --clean-cache",
    "docs:dev": "vuepress-vite dev docs",
    "docs:up": "pnpm dlx vp-update",
    "preview": "vite preview --host",
    "push:ge": "git push gitee main",
    "push:gh": "git push github main"
  },
  "devDependencies": {
    "@vue/repl": "^4.7.1",
    "@vuepress/bundler-vite": "2.0.0-rc.26",
    "@vuepress/plugin-comment": "2.0.0-rc.125",
    "@vuepress/plugin-notice": "2.0.0-rc.125",
    "@vuepress/plugin-register-components": "2.0.0-rc.125",
    "@vuepress/plugin-revealjs": "2.0.0-rc.125",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.125",
    "cross-env": "^7.0.3",
    "flowchart.ts": "^3.0.1",
    "katex": "^0.16.38",
    "mermaid": "^11.13.0",
    "sass-embedded": "^1.98.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "vuepress": "2.0.0-rc.26",
    "vuepress-plugin-components": "2.0.0-rc.103",
    "vuepress-plugin-md-enhance": "2.0.0-rc.103",
    "vuepress-theme-hope": "2.0.0-rc.103"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
