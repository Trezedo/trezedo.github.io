digraph "Doubly Linked List" {
    // node [fontname = "Georgia italic";];
    // 似乎只能通过 html-like 的 <i></i> 来加粗
    rankdir = LR;
    node [shape = record;];
    
    subgraph cluster_0 {
        e [label = "NULL";];
        a [label = " <ref1> | <data> a | <ref2>  ";];
        b [label = " <ref1> | <data> b | <ref2>  ";];
        c [label = " <ref1> | <data> c | <ref2>  ";];
        d [label = "NULL";];
    }
    
    edge [dir = both; arrowhead = vee; arrowtail = dot; tailclip = false;];
    e -> a:ref1:c [arrowhead = dot; arrowtail = vee; headclip = false; tailclip = true;];
    a:ref2:c -> b:data:w;
    b:ref2:c -> c:data:w;
    c:ref2:c -> d:data:w;
    c:ref1:c -> b:data:e;
    c:ref1:c -> b:data:w [weight = 100, style = invis];
    b:ref1:c -> a:data:e;
    b:ref1:c -> a:data:w [weight = 100, style = invis];
}